{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Git-connected Worker name in the Cloudflare dashboard.
  // Workers Builds fails the GitHub check when this does not match `sns-providers`.
  "name": "sns-providers",
  "main": "src/router.ts",
  "compatibility_date": "2026-08-21",
  "vars": {
    "DEFAULT_MONTHLY_BUDGET_USD": "3",
    "GROQ_MODEL": "llama-3.3-70b-versatile",
    "GROQ_BILLING_MODE": "free",
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    "DEEPSEEK_MODEL": "deepseek-chat",
    "TAVILY_BILLING_MODE": "free"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "social-mission"
      // database_id is omitted on purpose. A non-UUID placeholder made
      // Cloudflare Workers Builds preview deploys fail closed. Wrangler
      // resolves or provisions the named D1 database at deploy time.
    }
  ]
}
