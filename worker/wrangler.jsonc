{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "social-mission-api",
  "main": "src/router.ts",
  "compatibility_date": "2026-08-21",
  "vars": {
    "DEFAULT_MONTHLY_BUDGET_USD": "3",
    "GROQ_MODEL": "llama-3.3-70b-versatile",
    "GROQ_BILLING_MODE": "free",
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    "DEEPSEEK_MODEL": "deepseek-chat",
    "TAVILY_BILLING_MODE": "free"
    // Optional, non-secret. Leave unset for standalone (default). Set ARTIST_OS_MODE to
    // "artist_os_managed" to let My-SNS own Instagram inbound comment/DM events and the Meta webhook
    // (see docs/artist-os-managed-mode.md). Unknown non-empty values fail closed to managed.
    // "ARTIST_OS_MODE": "artist_os_managed"
    // Managed-mode relationship enrichment (read-only; see docs/artist-os-managed-mode.md):
    //   MY_SNS_URL (non-secret, https origin of My-SNS; set here or as a Worker var)
    //   "MY_SNS_URL": "https://my-sns.example"
    // Secrets (set with `wrangler secret put`, never commit values):
    //   ARTIST_OS_READ_TOKEN_SHA256  hex SHA-256 of the read-scoped token Artist OS presents to /api/service/*
    //   MY_SNS_READ_TOKEN            bearer token this Worker presents to My-SNS GET /api/service/v1/inbound-events
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "social-mission"
      // database_id is omitted on purpose. A non-UUID placeholder made local
      // and GitHub Actions deploys fail closed. Wrangler / the resolve script
      // patches a real UUID at deploy time when credentials are present.
    }
  ]
}
