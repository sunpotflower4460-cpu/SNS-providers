# Copy to .dev.vars for local Worker development. Never commit real keys.
GROQ_API_KEY=
GROQ_BILLING_MODE=free
GROQ_INPUT_PER_MILLION=
GROQ_OUTPUT_PER_MILLION=

DEEPSEEK_API_KEY=
DEEPSEEK_INPUT_PER_MILLION=
DEEPSEEK_OUTPUT_PER_MILLION=

# Optional free-first web discovery. Initial build only enables this adapter
# when explicitly marked free, so a pricing-plan change cannot silently spend money.
TAVILY_API_KEY=
TAVILY_BILLING_MODE=free

# Optional X public profile enrichment. X_USER_READ_USD must be set explicitly
# from the current official X API pricing before any paid read is allowed.
X_BEARER_TOKEN=
X_USER_READ_USD=

# Optional read-only X OAuth 2.0 PKCE connection.
# Configure the X App as a confidential Web App and set the exact Worker callback URL.
# Requested scopes are fixed in code to: tweet.read users.read follows.read offline.access
# The Worker also rejects the token response if X grants an unexpected scope or omits one.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_CALLBACK_URL=http://localhost:8787/api/x/oauth/callback
PWA_RETURN_URL=http://localhost:5173/
# Base64 of exactly 32 random bytes, used for AES-GCM encryption of X access/refresh tokens.
# Example: openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY_B64=

# Owned Reads are cheaper only when the authenticated X account is actually eligible
# under X's current Owned Reads rules (the app owner reading their own data).
# Verify current Developer Console pricing before enabling; leave false/blank to fail closed.
X_OWNED_READ_ELIGIBLE=false
X_OWNED_READ_USD=

# Optional Instagram Professional account engager sync.
# Uses the official Instagram API with Instagram Login / Graph API only to read comments
# on media owned by the configured Creator/Business account. Keep the token server-side.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Set explicitly to the currently supported Meta Graph API version, e.g. v24.0 after verifying.
INSTAGRAM_API_VERSION=

# Personal control token.
# It protects D1 state sync, budget status, AI ranking/self-analysis, Tavily discovery,
# optional X public enrichment, X OAuth start/disconnect + owned reads, and Instagram
# Professional engager sync. X OAuth status itself is a minimal setup/status read.
# Store only the SHA-256 hex on the Worker; the raw value stays on the user's device.
# Example on macOS/Linux: printf '%s' 'your-long-secret' | shasum -a 256
SYNC_TOKEN_SHA256=

DEFAULT_MONTHLY_BUDGET_USD=3
ALLOWED_ORIGIN=http://localhost:5173
