# Copy to .dev.vars for local Worker development. Never commit real keys.
GROQ_API_KEY=
GROQ_BILLING_MODE=free
GROQ_INPUT_PER_MILLION=
GROQ_OUTPUT_PER_MILLION=

DEEPSEEK_API_KEY=
DEEPSEEK_INPUT_PER_MILLION=
DEEPSEEK_OUTPUT_PER_MILLION=

# Optional free-first web discovery. Initial build only enables this adapter
# when explicitly marked free, so a pricing-plan change cannot silently spend money.
TAVILY_API_KEY=
TAVILY_BILLING_MODE=free

# Optional X public profile enrichment. X_USER_READ_USD must be set explicitly
# from the current official X API pricing before any paid read is allowed.
X_BEARER_TOKEN=
X_USER_READ_USD=

# Optional read-only X OAuth 2.0 PKCE connection.
# Configure the X App as a confidential Web App and set the exact Worker callback URL.
# Requested scopes are fixed in code to: tweet.read users.read follows.read offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_CALLBACK_URL=http://localhost:8787/api/x/oauth/callback
PWA_RETURN_URL=http://localhost:5173/
# Base64 of exactly 32 random bytes, used for AES-GCM encryption of X access/refresh tokens.
# Example: openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY_B64=

# Optional personal state sync. Store only the SHA-256 hex of the secret here.
# Example on macOS/Linux: printf '%s' 'your-long-secret' | shasum -a 256
SYNC_TOKEN_SHA256=

DEFAULT_MONTHLY_BUDGET_USD=3
ALLOWED_ORIGIN=http://localhost:5173
