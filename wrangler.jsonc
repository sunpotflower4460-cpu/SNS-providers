{
  // Git-connected Worker in the Cloudflare dashboard is named `sns-providers`.
  // Workers Builds looks for Wrangler config in the repository root; without
  // this file, PR checks fail immediately with "Deployment skipped" / missing
  // entry-point. This Worker serves the Vite PWA. The API Worker remains
  // worker/wrangler.jsonc (`social-mission-api`) and is deployed separately.
  "name": "sns-providers",
  "compatibility_date": "2026-08-21",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "npm run build"
  }
}
